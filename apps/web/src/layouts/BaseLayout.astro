---
interface Props {
  title?: string;
}
const { title = "CHOWKA BHARA" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0B1F3A" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-dvh bg-sky font-sans text-ink antialiased">
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --sky: #0b1f3a;
    --o2: #2ec4b6;
    --danger: #ff6b4a;
    --warn: #ffb020;
    --surface: #fff8f0;
  }

  body {
    background:
      radial-gradient(ellipse 120% 80% at 50% -20%, #1a4d6b 0%, transparent 55%),
      radial-gradient(ellipse 80% 50% at 100% 100%, #0e3d4a 0%, transparent 45%),
      linear-gradient(165deg, #0b1f3a 0%, #123a56 45%, #0b1f3a 100%);
    color: #fff8f0;
  }

  ::selection {
    background: rgba(46, 196, 182, 0.4);
    color: #fff;
  }
</style>
